# Production gateway environment (DO NOT commit real values)
# Set these in your host: Render, Railway, Fly.io, Docker secrets, etc.

SUPABASE_URL=https://qdnbwzyhuzgvosploprb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=use_host_secret_manager_not_this_file

PORT=4000
NODE_ENV=production
SERVICE_NAME=team-2-gateway
LOG_LEVEL=info

# Required in production: strong random string
ADMIN_API_KEY=generate_a_long_random_secret

# Optional: restrict admin/API access to known IPs (comma-separated)
IP_ALLOWLIST=
IP_BLOCKLIST=
PATH_BLOCKLIST=

# Optional service proxies
PROXY_REST_UPSTREAM_URL=
PROXY_GRAPHQL_UPSTREAM_URL=

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
