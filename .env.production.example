# Gateway production (set on gateway host only)
PORT=4000
NODE_ENV=production
SERVICE_NAME=team-2-gateway
LOG_LEVEL=info
# Leave unset in containers so logs stay on stdout for the platform log viewer.
# LOG_FILE_PATH=
HACKATHON_SERVICE_URL=http://hackathon-service:4001
JWT_SERVICE_URL=http://jwt-service:4004
AI_SERVICE_URL=
SCRAPER_SERVICE_URL=
GATEWAY_INTERNAL_SECRET=replace-with-a-long-random-secret
ADMIN_API_KEY=strong_random_secret
RATE_LIMIT_MAX=300

# Hackathon service production (set on hackathon-service host only)
# SUPABASE_URL=https://qdnbwzyhuzgvosploprb.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=from_secret_manager
# PORT=4001
# NODE_ENV=production
# GATEWAY_INTERNAL_SECRET=same-value-as-the-gateway

# JWT service production. AUTH_DATABASE_URL is the auth project. The same GATEWAY_INTERNAL_SECRET as the gateway.
# JWT_SECRET stays only on this service. Use: openssl rand -base64 32
# Do not set the local seed passwords in production. Create accounts with a password hash instead.
# PORT=4004
# JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# INVITE_URL_BASE=https://app.example.com/accept-invite
# GATEWAY_INTERNAL_SECRET=same-value-as-the-gateway
