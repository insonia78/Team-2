# === Gateway (port 4000) — copy to gateway/.env ===
PORT=4000
NODE_ENV=development
SERVICE_NAME=team-2-gateway
LOG_LEVEL=info
# JSON log file. Leave empty in Docker so the platform collects stdout.
LOG_FILE_PATH=logs/gateway.log
HACKATHON_SERVICE_URL=http://127.0.0.1:4001
JWT_SERVICE_URL=http://127.0.0.1:4004
# AI_SERVICE_URL=http://127.0.0.2:4002
# SCRAPER_SERVICE_URL=http://127.0.0.1:4003
GATEWAY_INTERNAL_SECRET=local-dev-gateway-secret
ADMIN_API_KEY=local-dev-admin-key
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# === Hackathon service (port 4001) — copy to services/hackathon-service/.env ===
# DATABASE_URL=postgresql://postgres.qdnbwzyhuzgvosploprb:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true
# PORT=4001
# LOG_LEVEL=info
# LOG_FILE_PATH=logs/hackathon-service.log
# GATEWAY_INTERNAL_SECRET=local-dev-gateway-secret

# === JWT service (port 4004) — copy to jwt-service/.env ===
# AUTH_DATABASE_URL is the auth project. JWT_SECRET lives only on this service.
# Generate it with: openssl rand -base64 32
# Change the seed passwords before sharing the database.
# PORT=4004
# JWT_SECRET=local-dev-jwt-secret-must-be-32-chars
# JWT_ISSUER=team-2-gateway
# INVITE_URL_BASE=http://localhost:3000/accept-invite
# GATEWAY_INTERNAL_SECRET=local-dev-gateway-secret
# SEED_VIEWER_EMAIL=viewer@local
# SEED_VIEWER_PASSWORD=change-me-viewer
# SEED_RESEARCHER_EMAIL=researcher@local
# SEED_RESEARCHER_PASSWORD=change-me-researcher
# SEED_ADMIN_EMAIL=admin@local
# SEED_ADMIN_PASSWORD=change-me-admin
