# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_keep_secret

# Gateway core
PORT=4000
NODE_ENV=development
SERVICE_NAME=team-2-gateway
LOG_LEVEL=info
LOG_FILE_PATH=

# Optional admin APIs for runtime blocklists
ADMIN_API_KEY=change-me-in-production

# Access control (comma-separated)
IP_ALLOWLIST=
IP_BLOCKLIST=
PATH_BLOCKLIST=

# Optional upstream proxies for future microservices
PROXY_REST_UPSTREAM_URL=
PROXY_GRAPHQL_UPSTREAM_URL=

# Rate limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
