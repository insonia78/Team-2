# PostgreSQL connection string (Supabase: Connect → Connection string → Session pooler, port 5432)
# URL-encode special characters in the password (@ → %40, # → %23, etc.)
# Prefer the pooler host on Windows (direct db.*.supabase.co is often IPv6-only).
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_ENCODED_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
DATABASE_SSL=true
DB_POOL_MAX=10

PORT=4001
NODE_ENV=development
SERVICE_NAME=hackathon-service
LOG_LEVEL=info
LOG_FILE_PATH=logs/hackathon-service.log
