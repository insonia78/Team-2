# Auth project. Apply supabase/auth/001_auth.sql. DATABASE_URL is used when AUTH_DATABASE_URL is unset.
AUTH_DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
DATABASE_SSL=true

PORT=4004
NODE_ENV=development
SERVICE_NAME=jwt-service
LOG_LEVEL=info
LOG_FILE_PATH=logs/jwt-service.log

# Signing secret for this service only.
JWT_SECRET=local-dev-jwt-secret-must-be-32-chars
JWT_ISSUER=team-2-gateway
JWT_TTL_SECONDS=7200
INVITE_URL_BASE=http://localhost:3000/accept-invite
INVITE_TTL_SECONDS=604800
GATEWAY_INTERNAL_SECRET=local-dev-gateway-secret
BCRYPT_ROUNDS=12

# Optional. Leave MAIL_SERVICE_URL empty to return invite links without sending them.
# MAIL_SERVICE_URL=http://127.0.0.1:4005

# Optional Codyza directory. All four LDAP connection values are required together.
# LDAP_URL=ldap://localhost:389
# LDAP_BIND_DN=cn=service,dc=codyza,dc=local
# LDAP_BIND_PASSWORD=replace-me
# LDAP_BASE_DN=dc=codyza,dc=local
# LDAP_USER_FILTER=(mail={{email}})
# LDAP_GROUP_ADMIN=cn=admins,dc=codyza,dc=local
# LDAP_GROUP_RESEARCHER=cn=research,dc=codyza,dc=local
# LDAP_GROUP_VIEWER=cn=viewers,dc=codyza,dc=local

# Created on startup when both the email and password are set. Change these before sharing the database.
SEED_VIEWER_EMAIL=viewer@local
SEED_VIEWER_PASSWORD=change-me-viewer
SEED_RESEARCHER_EMAIL=researcher@local
SEED_RESEARCHER_PASSWORD=change-me-researcher
SEED_ADMIN_EMAIL=admin@local
SEED_ADMIN_PASSWORD=change-me-admin
